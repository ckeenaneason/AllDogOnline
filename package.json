{
  "name": "alldogonline",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test -w @ado/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @ado/extension",
    "build": "npm run build -w @ado/extension",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:generate": "npm run generate -w @ado/db",
    "db:migrate": "npm run migrate -w @ado/db",
    "shell": "npm start -w @ado/backend-shell",
    "shell:dev": "npm run dev -w @ado/backend-shell"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "dependencies": {
    "vitest": "5.1.0"
  }
}
