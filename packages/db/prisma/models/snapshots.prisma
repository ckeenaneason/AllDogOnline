/**
 * SNAPSHOTS
 * Raw, validated submissions from the extension. This is the source of truth:
 * every aggregate can be rebuilt from these tables. Rows are never edited after
 * ingest, only revoked (soft-deleted) and un-revoked.
 * Eventual growth may require intermediary aggregation processes.
 */

/// The kind of activity/event that produced a snapshot. Each value has unique
/// parsing on ingest and its own `Source.key` format (see `buildSourceKey()`).
///
/// Only update with ingest code to handle the new type
///
/// @namespace Snapshots
enum SourceType {
  MOB /// Lonely Tower mob kill
  CHEST /// Lonely Tower chest
  GACHA /// Gachapon machine. Drop pool split by variant (`Source.variant`)
  BUSH /// Bush rummage, single pool
  TOGBU /// Treat or get blown up, Single pool
  CACTUS /// Giant cactus pick, single pool
  FISH /// Fish cast, pool depends on FishCondition
  FARM /// Farm action (TODO)
}

/// One drop pool, i.e. Bucket. Comprised of a drop source entity plus the conditions
/// that impact its loot. Every Snapshot points at exactly one Source, and aggregates
/// are grouped by Source.
///
/// Written by: ingest
/// Identity: `key`, built only by `buildSourceKey()`
///
/// Links are dictated by type:
///   MOB - mob, floor
///   CHEST - chest, floor
///   FISH - fishCondition
///   GACHA - variant
///   FARM - TODO
///   BUSH, CACTUS, TOGBU - nothing (single pool)
///
/// @namespace Snapshots
model Source {
  id Int @id @default(autoincrement())

  /// `TYPE|external_id|...conditions`, all lowercase
  /// e.g. `MOB|enemy_booby_trap|floor_2`
  /// `FISH|spooky|gumchum|rod_stick|snowy|evening`
  key      String  @unique
  reviewed Boolean @default(false)

  /// Drop pool variant tracking for one-off cases, such as
  /// gachapon token, temple `game:difficulty`. Null otherwise.
  variant String?

  mobId           Int?
  mob             Mob?           @relation(fields: [mobId], references: [id])
  chestId         Int?
  chest           Chest?         @relation(fields: [chestId], references: [id])
  floorId         Int?
  floor           Floor?         @relation(fields: [floorId], references: [id])
  fishConditionId Int?
  fishCondition   FishCondition? @relation(fields: [fishConditionId], references: [id])

  aggSource AggSource[]
  snapshots Snapshot[]

  @@index([mobId, floorId])
  @@index([fishConditionId])
  @@index([chestId, floorId])
}

/// One encounter outcome. An encounter that produced nothing still gets a row, as it is
/// part of the denominator for all rates.
///
/// Written by: ingest ONLY. Never edited afterwards except to revoke/unrevoke.
/// Identity: `id`, a UUID generated by the extension. Resubmitting the same snapshot will
/// not update data (no-op)
///
/// Errors, cooldowns, etc. are rejected on injest because no encounter happened.
///
/// @namespace Snapshots
model Snapshot {
  id String @id /// pull from submission - uuid - for idempotency

  /// The drop pool for this encounter
  sourceId Int
  source   Source @relation(fields: [sourceId], references: [id])

  schemaVersion    Int /// Snapshot payload schema version (extension)
  extensionVersion String /// Extension version for snapshot (e.g. `0.4.0`)
  /// Game frontend build ID. Changes every site deploy, not just loot changes, 
  /// so store for debugging ONLY. DropEpoch distinguishes 'releases'
  doBuildId        String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  recordedAt DateTime /// When the encounter happened, per client clock.
  receivedAt DateTime @default(now()) /// When the server accepted the snapshot, trusted clock

  /// Allows exclusion from aggregation (soft deletion). Clear these fields to restore,
  /// then run `rebuildAgg()`
  revokedAt     DateTime?
  revokedReason String? /// Reason revoked

  drops ItemDrop[]
  coins CoinDrop[]

  @@index([userId])
  @@index([sourceId])
  @@index([receivedAt])
}

/// Items received in one encounter, one row per distinct ITEM.
/// Repeat items get collapsed into `quantity`
///
/// Written by: ingest, `mergeItems()`
/// Identity: (`snapshotId`, `itemId`). Merging two items must SUM quantities on conflict.
///
/// @namespace Snapshots
model ItemDrop {
  snapshotId String
  itemId     Int
  quantity   Int    @default(1)

  snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@id([snapshotId, itemId])
  @@index([itemId])
}

/// Coin packages received in one encounter, one row per package size.
/// Coins drop from encounters in discrete packages (50, 100, 500...), so each size is
/// tracked like an item. A reported amount of 0 is not a drop and gets no row.
///
/// Written by: ingest
/// Identity: (`snapshotId`, `coinId`)
///
/// @namespace Snapshots
model CoinDrop {
  snapshotId String //uuid
  coinId     Int
  quantity   Int    @default(1)

  snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  coin     Coin     @relation(fields: [coinId], references: [id])

  @@id([snapshotId, coinId])
  @@index([coinId])
}

/// A distinct combination of fishing conditions. Reused across every Source and
/// snapshot that shares it.
///
/// Written by: ingest
/// Identity: (`weatherId`, `areaId`, `baitId`, `toolId`). All four are required for
/// the unique constraint to work, so casting without bait or tool uses the sentinel items
/// `no_bait` and `no_tool`, never NULL
///
/// @namespace Snapshots
model FishCondition {
  id Int @id @default(autoincrement())

  weatherId Int
  weather   Weather @relation(fields: [weatherId], references: [id])

  areaId Int
  area   FishingArea @relation(fields: [areaId], references: [id])

  /// Item or `no_bait` sentinel item
  baitId Int
  bait   Item @relation(name: "bait", fields: [baitId], references: [id])

  /// Item or `no_tool` sentinel item
  toolId Int
  tool   Item @relation(name: "tool", fields: [toolId], references: [id])

  source Source[]

  @@unique([weatherId, areaId, baitId, toolId])
}

/// A weather condition and time of day pair
///
/// Written by: ingest
/// Identity: (`timeOfDay`, `weather`), both normalized to lowercase
///
/// @namespace Snapshots
model Weather {
  id        Int    @id @default(autoincrement())
  timeOfDay String
  weather   String

  fishCondition FishCondition[]

  @@unique([timeOfDay, weather])
}
